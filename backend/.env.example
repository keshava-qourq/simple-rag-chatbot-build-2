# Copy this file to `.env` and fill in real values locally. `.env` is
# git-ignored (see backend/.gitignore) and must never be committed. This
# file must never contain a real key or secret -- every value below is a
# placeholder or a documented default.

# --- LLM (OpenAI-compatible provider; this is the documented default) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=gpt-4o-mini

# --- Embeddings ---
# Leave EMBEDDING_API_KEY blank to reuse LLM_API_KEY when EMBEDDING_PROVIDER
# matches LLM_PROVIDER (the common single-provider setup).
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval / chunking ---
# Fixed at process start; there is no API to change these at runtime.
# Defaults: chunk size ~800-1000 characters, overlap ~15% of chunk size,
# five chunks retrieved per question.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# --- Persistence (local disk; survives a process/container restart) ---
# Leave both blank to use the documented local-disk defaults, resolved
# relative to this backend's own install location (not the current working
# directory), so a restart from anywhere finds the same files:
#   DATABASE_URL          -> sqlite:///<repo>/backend/data/app.db
#   DOCUMENT_STORAGE_DIR   -> <repo>/backend/data/documents
# Both directories are created automatically on first run and are never
# dropped or recreated by the app -- only missing tables are created.
# In Docker these are instead set (see Dockerfile) to:
#   DATABASE_URL=sqlite:////app/data/app.db
#   DOCUMENT_STORAGE_DIR=/app/data/documents
# with /app/data declared as the container's persistent volume -- mount a
# volume or bind-mount there so a container restart keeps the library.
DATABASE_URL=
DOCUMENT_STORAGE_DIR=

# --- Misc ---
MAX_UPLOAD_MB=20.0
ALLOWED_ORIGINS=
